{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Resonix",
  "version": "2.4.0",
  "identifier": "org.resonix.hiresplayer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Resonix",
        "width": 1360,
        "height": 860,
        "minWidth": 400,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://www.youtube.com https://s.ytimg.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; media-src 'self' blob: https: http:; connect-src 'self' blob: https: http:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Open music player",
    "longDescription": "Plays your own music files plus openly licensed music from Audius, the Internet Archive, Openverse and Jamendo, and live radio. It includes on-device tempo, key and loudness analysis, synced lyrics, an EQ and a raga clock.",
    "android": {
      "minSdkVersion": 26
    },
    "iOS": {
      "developmentTeam": ""
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFMkE4QjJBQUMwMzJFOUYKUldTZkxnT3NLb3NxSHRudnY1MlFWd3B1TStDZS9ybmJaaUJkbG12R1dKcG9XVklvK1NTUFVNLysK",
      "endpoints": [
        "https://github.com/krishnasidhvi/resonix-audio-player/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
